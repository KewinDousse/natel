{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/deepseek/deepseek-v4-flash",
  "subagent_depth": 1,
  "agent": {
    "lead": {
      "description": "Orchestrates one roadmap task: dev → review → fix, max 3 rounds, then reports.",
      "mode": "primary",
      "model": "openrouter/z-ai/glm-5.3",
      "prompt": "{file:./.opencode/prompts/lead.md}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git *": "allow",
          "pnpm check*": "allow"
        }
      }
    },
    "dev": {
      "description": "Implements a clearly scoped task following AGENTS.md. Invoked by lead.",
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash",
      "prompt": "{file:./.opencode/prompts/dev.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "reviewer": {
      "description": "Read-only code review against AGENTS.md and ARCHITECTURE.md. Invoked by lead.",
      "mode": "subagent",
      "model": "openrouter/z-ai/glm-5.3",
      "prompt": "{file:./.opencode/prompts/reviewer.md}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "git status*": "allow",
          "pnpm check*": "allow"
        }
      }
    }
  }
}
