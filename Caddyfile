{
  # The reverse proxies in front of Natel, if any: their X-Forwarded-For
  # (and -Proto, -Host) is kept, so the CardDAV server sees the client's
  # address, not the proxy's. Unset, no one is trusted and a client's
  # X-Forwarded-* headers are dropped.
  servers {
    trusted_proxies static {$NATEL_TRUSTED_PROXIES}
  }
  # Caddy's admin API reconfigures it without authentication, for anyone on
  # the machine: off unless NATEL_ADMIN gives it an address. The image sets
  # 127.0.0.1:2019, not published, for its healthcheck.
  admin {$NATEL_ADMIN:off}
  # The image runs without root, so it listens on 8080 and 8443.
  http_port {$NATEL_HTTP_PORT:80}
  https_port {$NATEL_HTTPS_PORT:443}
  log {
    level error
  }
}

(security_headers) {
  header {
    # HSTS — 1 year, include subdomains
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # Prevent MIME sniffing
    X-Content-Type-Options "nosniff"
    # Don't let the page be framed
    X-Frame-Options "DENY"
    # Everything the app loads comes from this origin, the CardDAV server
    # included (through /dav). Photos from vCards are shown as data: or
    # blob: URLs.
    Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
    # A link out doesn't tell the site where this instance lives
    Referrer-Policy "no-referrer"
    # A window that opened the app, or that it opens, gets no handle on it
    Cross-Origin-Opener-Policy "same-origin"
    # Other sites can't load the app's files
    Cross-Origin-Resource-Policy "same-origin"
    # Features the app never asks for
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  }
}

{$SITE_ADDRESS:http://} {
  # ---------------------------------------------------------------
  # CardDAV proxy — forward /dav/* to the user's CardDAV server
  # ---------------------------------------------------------------
  # The app mirrors full server paths under /dav: e.g. a request to
  # /dav/dav.php/… reaches {$BAIKAL_URL}/dav.php/… (prefix stripped).
  handle_path /dav/* {
    # Only the methods the app sends. Every path of the server is reachable
    # from here, so any other, a GET or a POST, would reach whatever else it
    # runs, such as Baïkal's admin and its installer. Vite's proxy does the same.
    @unused not method PROPFIND REPORT PUT DELETE
    header @unused Allow "PROPFIND, REPORT, PUT, DELETE"
    respond @unused 405
    reverse_proxy {$BAIKAL_URL} {
      # The upstream's own name, so a virtual host in front of it matches.
      header_up Host {upstream_hostport}
      # Redirects (e.g. /.well-known/carddav) point into the server's URL
      # space; put them back under /dav so the browser can follow them.
      header_down Location "^(https?://[^/]+)?/" "/dav/"
      # A 401 carrying WWW-Authenticate makes the browser open its own login
      # prompt over the app. The app sends credentials itself and reports a
      # rejected login on its own, so the challenge is dropped.
      header_down -WWW-Authenticate
      # The app authenticates every request itself. A session cookie the
      # server sets (Baïkal and Nextcloud do, even for Basic auth) would
      # outlive the logout in the browser, against "no credentials at rest".
      header_up -Cookie
      header_down -Set-Cookie
    }
    # The app only fetches from here; a page the server renders (an error,
    # sabre/dav's browser) must not run as the app's origin.
    header Content-Security-Policy "sandbox; default-src 'none'; frame-ancestors 'none'"
    header X-Content-Type-Options "nosniff"
    header Referrer-Policy "no-referrer"
  }

  # ---------------------------------------------------------------
  # Static SPA — serve the Vite build output (catch-all)
  # ---------------------------------------------------------------
  # Vite names these files after their content: a name never changes
  # content, so browsers keep them for good. A chunk from an older version
  # is gone: a 404, not index.html served as a script.
  handle /assets/* {
    root * /usr/share/caddy
    @exists file
    header @exists Cache-Control "public, max-age=31536000, immutable"
    file_server
    import security_headers
  }

  # Everything else, index.html first, is revalidated, so a new version
  # shows on the next load.
  handle {
    root * /usr/share/caddy
    header Cache-Control "no-cache"
    try_files {path} /index.html
    file_server
    import security_headers
  }
}