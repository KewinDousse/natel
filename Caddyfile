{
  log {
    level error
  }
}

(security_headers) {
  header {
    # HSTS — 1 year, include subdomains
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # Prevent MIME sniffing
    X-Content-Type-Options "nosniff"
    # Basic XSS protection
    X-XSS-Protection "1; mode=block"
    # Don't let the page be framed
    X-Frame-Options "DENY"
  }
}

{$SITE_ADDRESS:http://:80} {
  # ---------------------------------------------------------------
  # CardDAV proxy — forward /dav/* to the user's CardDAV server
  # ---------------------------------------------------------------
  # The app mirrors full server paths under /dav: e.g. a request to
  # /dav/dav.php/… reaches {$BAIKAL_URL}/dav.php/… (prefix stripped).
  handle_path /dav/* {
    reverse_proxy {$BAIKAL_URL} {
      # The upstream's own name, so a virtual host in front of it matches.
      header_up Host {upstream_hostport}
      # Redirects (e.g. /.well-known/carddav) point into the server's URL
      # space; put them back under /dav so the browser can follow them.
      header_down Location "^(https?://[^/]+)?/" "/dav/"
      # A 401 carrying WWW-Authenticate makes the browser open its own login
      # prompt over the app. The app sends credentials itself and reports a
      # rejected login on its own, so the challenge is dropped.
      header_down -WWW-Authenticate
    }
  }

  # ---------------------------------------------------------------
  # Static SPA — serve the Vite build output (catch-all)
  # ---------------------------------------------------------------
  handle {
    root * /usr/share/caddy
    try_files {path} /index.html
    file_server
    import security_headers
  }
}