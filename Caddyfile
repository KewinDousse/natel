{
  # The reverse proxies in front of Natel, if any: their X-Forwarded-For
  # (and -Proto, -Host) is kept, so the CardDAV server sees the client's
  # address, not the proxy's. Unset, no one is trusted and a client's
  # X-Forwarded-* headers are dropped.
  servers {
    trusted_proxies static {$NATEL_TRUSTED_PROXIES}
    # Caddy's total read budget is not enforced on HTTP/3.
    protocols h1 h2
    timeouts {
      read_header 1m
      read_body 10m
      # The idle reader can leave HTTP/1.1 uploads blocked.
      read_body_idle -1s
    }
  }
  # Caddy's admin API reconfigures it without authentication, for anyone on
  # the machine: off when NATEL_ADMIN is unset or `off`, on at the address it
  # gives otherwise. Set but empty, it turns the API on at localhost:2019,
  # since the `:off` fallback below covers only an unset variable. The image
  # sets 127.0.0.1:2019, not published, for its healthcheck.
  admin {$NATEL_ADMIN:off}
  # The image runs without root, so it listens on 8080 and 8443.
  http_port {$NATEL_HTTP_PORT:80}
  https_port {$NATEL_HTTPS_PORT:443}
  # The interface to listen on, all when unset: 127.0.0.1 keeps a Natel
  # behind a proxy on the same machine out of reach around it.
  default_bind {$NATEL_BIND}
  log {
    level INFO
    output stdout
    # Free-form HTTP errors can quote private upstream bytes; access logs keep their status.
    exclude http.log.error http.handlers.reverse_proxy
    format filter {
      wrap json
      fields {
        request>uri delete
        request>headers delete
        request>host delete
        request>remote_ip delete
        request>remote_port delete
        request>client_ip delete
        request>tls delete
        resp_headers delete
        user_id delete
      }
    }
  }
}

(security_headers) {
  header {
    # HTTPS only, for a year, on this host alone: its subdomains are their
    # owner's to decide, and Natel uses no cookie for one of them to reach.
    Strict-Transport-Security "max-age=31536000"
    # Prevent MIME sniffing
    X-Content-Type-Options "nosniff"
    # Don't let the page be framed
    X-Frame-Options "DENY"
    # Everything the app loads comes from this origin, the CardDAV server
    # included (through /dav). Photos from vCards are shown as data: or
    # blob: URLs. No string reaches an HTML sink such as innerHTML, or loads
    # as a script, a worker included (Trusted Types): the app has none, so a
    # card's content never becomes markup. A worker would need a policy here.
    Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types 'none'"
    # A link out doesn't tell the site where this instance lives
    Referrer-Policy "no-referrer"
    # A window that opened the app, or that it opens, gets no handle on it
    Cross-Origin-Opener-Policy "same-origin"
    # Other sites can't load the app's files
    Cross-Origin-Resource-Policy "same-origin"
    # Features the app never asks for
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  }
}

{$SITE_ADDRESS:http://} {
  # Use the global logger's privacy filter for access logs.
  log
  @not_dav expression `!{http.request.uri}.startsWith("/dav/")`
  log_skip @not_dav

  # ---------------------------------------------------------------
  # CardDAV proxy — forward /dav/* to the user's CardDAV server
  # ---------------------------------------------------------------
  # The app mirrors full server paths under /dav: e.g. a request to
  # /dav/dav.php/… reaches {$CARDDAV_URL}/dav.php/… (prefix stripped).
  # Match escaped paths before the static handlers normalise them.
  @dav expression `{http.request.uri}.startsWith("/dav/")`
  handle @dav {
    uri path_regexp "^/dav" ""
    # In order: forward_auth would otherwise run before respond.
    route {
      # Only the methods the app sends. Every path of the server is reachable
      # from here, so any other, a GET or a POST, would reach whatever else it
      # runs, such as Baïkal's admin and its installer. Vite's proxy does the same.
      @unused not method PROPFIND REPORT PUT DELETE
      header @unused Allow "PROPFIND, REPORT, PUT, DELETE"
      respond @unused 405
      # The session cookie gets the request its credentials from natel-session
      # (ADR 032), replacing any Authorization the client sent. Without a
      # live session, its 401 goes back to the client.
      forward_auth {$NATEL_SESSION_ADDR:127.0.0.1:2020} {
        uri /auth
        # natel-session gives Caddy the secret, so nothing else on the
        # loopback but the admin API can trade a session cookie for the
        # password. A caddy reload from outside natel-session drops it.
        header_up Natel-Session-Secret {$NATEL_SESSION_SECRET}
        copy_headers Authorization
      }
    }
    reverse_proxy {$CARDDAV_URL} {
      # The upstream's own name, so a virtual host in front of it matches.
      header_up Host {upstream_hostport}
      # Redirects (e.g. /.well-known/carddav) point into the server's URL
      # space; put them back under /dav so the browser can follow them.
      # Steps: drop the scheme and host, resolve a relative target against
      # the request path, decode and clean whole dot segments only, then
      # prefix /dav. src/dav/proxy-location.ts mirrors it for http(s)
      # targets in Vite's proxy; tests/e2e/proxy-redirects.spec.ts runs the
      # same cases through Vite and, against the image, through this file.
      # A change here goes with both.
      @redirect header Location *
      handle_response @redirect {
        route {
          map {rp.header.Location} {dav_location} {
            ~^(?i:https?:)?//+[^/?#]+(/.*)$ ${1}
            ~^(?i:https?:)?//+[^/?#]+([?#].*)?$ /${1}
            default {rp.header.Location}
          }
          vars dav_location {dav_location}
          @fragment expression `{vars.dav_location}.startsWith('#')`
          vars @fragment dav_location ""
          @relative expression `!{vars.dav_location}.startsWith('/') && !{vars.dav_location}.startsWith('?') && !{vars.dav_location}.startsWith('#') && {vars.dav_location} != ''`
          uri @relative path_regexp "[^/]*$" ""
          @path expression `!{vars.dav_location}.startsWith('?') && !{vars.dav_location}.startsWith('#') && {vars.dav_location} != ''`
          route {
            rewrite @path ?
          }
          map {uri} {dav_base} {
            ~^([^?]*).* ${1}
          }
          map {vars.dav_location} {dav_target} {
            "" {uri}
            ~^(/.*)$ ${1}
            default {dav_base}{vars.dav_location}
          }
          vars dav_target {dav_target}
          map {vars.dav_target} {dav_target_path} {
            ~^([^?#]*).* ${1}
          }
          # Keep the escaped path across rewrite, whose query handling avoids placeholder injection.
          request_header Natel-Redirect-Path {dav_target_path}
          request_header Natel-Redirect-Path "[$]" "$$$$"
          route {
            rewrite {vars.dav_target}
          }
          uri path_regexp "^.*$" {http.request.header.Natel-Redirect-Path}
          # Only whole dot segments are decoded; an escaped slash stays in its segment.
          uri path_regexp "(?i)(^|/)(%2e(%2e|[.])|[.]%2e)(/|$)" "$1..$4"
          uri path_regexp "(?i)(^|/)(%2e(%2e|[.])|[.]%2e)(/|$)" "$1..$4"
          uri path_regexp "(?i)(^|/)%2e(/|$)" "$1.$2"
          uri path_regexp "(?i)(^|/)%2e(/|$)" "$1.$2"
          uri path_regexp "((^|/)[.]{1,2})$" "$1/"
          # An identity replacement cleans dot segments without merging empty segments.
          uri replace // //
          request_header -Natel-Redirect-Path
          header >Location /dav{uri}
          copy_response
        }
      }
      # A 401 carrying WWW-Authenticate makes the browser open its own login
      # prompt over the app. Natel sends credentials itself and reports a
      # rejected login on its own, so the challenge is dropped.
      header_down -WWW-Authenticate
      # Natel's session cookie is for natel-session only. A session cookie
      # the server sets (Baïkal and Nextcloud do, even for Basic auth) would
      # outlive the logout in the browser.
      header_up -Cookie
      header_down -Set-Cookie
      # The server's own copies of the headers set below would add to them,
      # and its software and version are nobody's business.
      header_down -Content-Security-Policy
      header_down -X-Content-Type-Options
      header_down -Referrer-Policy
      header_down -Server
      header_down -X-Powered-By
    }
    # The app only fetches from here; a page the server renders (an error,
    # sabre/dav's browser) must not run as the app's origin.
    header Content-Security-Policy "sandbox; default-src 'none'; frame-ancestors 'none'"
    header X-Content-Type-Options "nosniff"
    header Referrer-Policy "no-referrer"
  }

  # ---------------------------------------------------------------
  # Sessions — sign-in and sign-out, held by natel-session (ADR 032)
  # ---------------------------------------------------------------
  # Its other routes, /auth and /healthz, stay on the loopback.
  handle /session {
    reverse_proxy {$NATEL_SESSION_ADDR:127.0.0.1:2020}
    import security_headers
  }

  # ---------------------------------------------------------------
  # Static SPA — serve the Vite build output (catch-all)
  # ---------------------------------------------------------------
  # Vite names these files after their content: a name never changes
  # content, so browsers keep them for good. A chunk from an older version
  # is gone: a 404, not index.html served as a script.
  handle /assets/* {
    root * {$NATEL_ROOT:/usr/share/caddy}
    # No file or folder whose name starts with a dot (a .env, .git/) is ever
    # served, here or in the next handle: the app has none. Matched on the
    # request, so NATEL_ROOT itself may sit in any folder.
    @hidden path */.*
    error @hidden 404
    # The header below runs before the 404: without this, a hidden file
    # that exists would get it, which a missing one doesn't.
    @exists {
      file
      not path */.*
    }
    header @exists Cache-Control "public, max-age=31536000, immutable"
    file_server
    import security_headers
  }

  # Everything else, index.html first, is revalidated, so a new version
  # shows on the next load.
  handle {
    root * {$NATEL_ROOT:/usr/share/caddy}
    header Cache-Control "no-cache"
    # The app, as for any other path: nothing tells whether such a file exists.
    @hidden path */.*
    rewrite @hidden /index.html
    try_files {path} /index.html
    file_server
    import security_headers
  }
}
