{
  log {
    level error
  }
}

(security_headers) {
  header {
    # HSTS — 1 year, include subdomains
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # Prevent MIME sniffing
    X-Content-Type-Options "nosniff"
    # Basic XSS protection
    X-XSS-Protection "1; mode=block"
    # Don't let the page be framed
    X-Frame-Options "DENY"
  }
}

{$SITE_ADDRESS:http://:80} {
  # ---------------------------------------------------------------
  # Static SPA — serve the Vite build output
  # ---------------------------------------------------------------
  root * /usr/share/caddy
  try_files {path} /index.html
  file_server

  import security_headers

  # ---------------------------------------------------------------
  # CardDAV proxy — forward /dav/* to the user's CardDAV server
  # ---------------------------------------------------------------
  # Note: SITE_ADDRESS is configurable so Caddy can terminate TLS
  # automatically when a public hostname is set. HTTP-only by default
  # for use behind a user's reverse proxy.
  handle /dav/* {
    reverse_proxy {$BAIKAL_URL}
  }
}